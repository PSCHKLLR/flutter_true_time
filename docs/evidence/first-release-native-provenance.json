  "nativeBuildDeclarations": {
    "flutter_secure_storage_windows": "Builds the C++ plugin from source and links Flutter and its wrapper. Source declares version.lib and bcrypt.lib. CMake lists no bundled auxiliary libraries and limits GoogleTest to the test target.",
