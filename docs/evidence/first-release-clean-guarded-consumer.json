    "import 'package:flutter/material.dart';",
    "import 'package:flutter_true_time/flutter_true_time.dart';",
    "",
    "void main() {",
    "  var status = 'unexpected';",
    "  try {",
    "    TrustedTime.read();",
    "  } on TrustedTimeException catch (error) {",
    "    status = error.code;",
    "  }",
    "  runApp(MaterialApp(home: Scaffold(body: Text('Selected package consumer: $status'))));",
    "}",
    "",
    "Future<void> checkFacade() => TrustedTime.dispose();"
  ],
  "consumerTests": [
    "import 'package:flutter_test/flutter_test.dart';",
    "import 'package:flutter_true_time/core.dart';",
    "import 'package:flutter_true_time/flutter_true_time.dart';",
    "import 'package:preflight_consumer/main.dart' as app;",
    "",
    "class FixtureSource implements TimeSource {",
    "  const FixtureSource(this.id);",
    "  @override",
    "  final String id;",
    "  @override",
    "  String get endpoint => id;",
    "  @override",
    "  String get providerGroup => id;",
    "  @override",
    "  String get configurationKey => id;",
    "",
    "  @override",
    "  Future<TimeSample> query(",
    "    MonotonicClock clock,",
    "    Duration timeout, {",
    "    CancellationSignal? cancellation,",
    "  }) async {",
    "    final at = clock.snapshot();",
    "    return TimeSample(",
    "      utc: DateTime.utc(2026, 11, 12).add(at.elapsed),",
    "      at: at,",
    "      uncertainty: const Duration(milliseconds: 5),",
    "    );",
    "  }",
    "}",
    "",
    "void main() {",
    "  test('external consumer receives the uninitialized facade error', () {",
    "    expect(() => TrustedTime.read(), throwsA(isA<TrustedTimeException>().having((error) => error.code, 'code', 'uninitialized')));",
    "  });",
    "  test('external consumer syncs from two independent fixture sources', () async {",
    "    final engine = TrustedTimeEngine(",
    "      sources: const [FixtureSource('one'), FixtureSource('two')],",
    "      autoRefresh: false,",
    "    );",
    "    addTearDown(engine.dispose);",
    "    expect((await engine.sync()).success, isTrue);",
    "    final reading = engine.read();",
    "    expect(reading.availability, TimeAvailability.ready);",
    "    expect(reading.providerGroups, unorderedEquals(['one', 'two']));",
    "    expect(reading.utc.isUtc, isTrue);",
    "    expect(reading.uncertainty, greaterThanOrEqualTo(Duration.zero));",
    "  });",
    "  testWidgets('consumer starts', (tester) async {",
    "    app.main();",
    "    await tester.pumpAndSettle();",
    "    expect(find.text('Selected package consumer: uninitialized'), findsOneWidget);",
    "  });",
    "}"
  ],
